{
  "name": "codewalk-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --open",
    "dev:stop": "astro dev stop",
    "build": "astro build",
    "preview": "astro preview",
    "check:notes": "node check/notes.mjs",
    "check:progress": "node check/progress.mjs",
    "check": "astro build && node check/run.mjs",
    "check:stale": "node check/stale.mjs",
    "check:update": "node check/update.mjs",
    "check:visual": "node check/visual.mjs",
    "hooks": "node check/hooks.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "astro": "7.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
